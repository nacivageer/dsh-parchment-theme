{
  "name": "dsh-parchment-theme",
  "version": "0.1.7",
  "description": "A parchment (aged-paper) theme layer for the DeepSeek Harness Web GUI: warm paper surfaces, ink-brown type, a Song-serif text stack, and a dark ink-paper counterpart that follows the system color scheme.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "license": "MIT",
  "author": "72NG (https://github.com/nacivageer)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacivageer/dsh-parchment-theme.git"
  },
  "homepage": "https://github.com/nacivageer/dsh-parchment-theme#readme",
  "bugs": {
    "url": "https://github.com/nacivageer/dsh-parchment-theme/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "theme",
    "parchment",
    "sepia",
    "ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
